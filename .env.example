# Copy this file to ".env" and paste your keys. Never commit the real .env.

# Gemini powers the text copy. Get a key at https://aistudio.google.com
GEMINI_API_KEY=your_key_here

# Pexels powers the background photos (free, generous limits).
# Get a key at https://www.pexels.com/api/  -> "Your API Key".
# If this is empty the pipeline falls back to locally-drawn gradient backgrounds.
PEXELS_API_KEY=your_pexels_key_here

# Telegram approval bot
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Facebook page posting
FB_PAGE_TOKEN=your_page_token_here
FB_PAGE_ID=your_page_id_here
